# 生产镜像构建上下文不得包含运行时机密、用户数据和本地依赖。
.git
.gitignore
.env
backend/.env
backend/config.override.json
Gugu-data
uploads
backend/uploads
backend/.venv
backend/.deploy-backups
backend/__pycache__
backend/**/__pycache__/
backend/**/*.pyc
backend/.pytest_cache
backend/logs
backend/data
backend/var
backend/.DS_Store
backend/config.override.json.bak-*
backend/bin/node_modules
backend/ts/**/node_modules
frontend/node_modules
frontend/dist
frontend/dist-desktop
frontend/test-results
frontend/playwright-report
node_modules
*.log
.DS_Store
._*
**/._*

# Core 的本机安装与构建产物不进入镜像上下文。
gugu-core/.venv
gugu-core/build
gugu-core/dist
gugu-core/node_modules
compat/core-python/build
compat/core-python/dist
compat/core-python/src/*.egg-info
compat/desktop-python/python/*.egg-info
gugu-core/src/*.egg-info
gugu-core/**/__pycache__/
gugu-core/**/*.pyc
gugu-desktop/.tools
gugu-desktop/node_modules
gugu-desktop/**/__pycache__/
gugu-webui/node_modules
gugu-webui/dist
gugu-webui/.env
gugu-webui/.env.*.local
