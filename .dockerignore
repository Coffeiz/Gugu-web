backend/.pytest_cache
backend/logs
backend/data
backend/var
backend/.DS_Store
backend/config.override.json.bak-*
backend/bin/node_modules
backend/ts/**/node_modules
apps/web/node_modules
apps/web/dist
apps/web/dist-desktop
apps/web/test-results
apps/web/playwright-report
node_modules
*.log
.DS_Store
._*
**/._*

