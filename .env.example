# 咕咕 Compose 编排环境变量示例
# 用法：复制为项目根目录 .env，供 Docker Compose 做变量替换：
#   cp .env.example .env
#   cp backend/.env.example backend/.env
#
# 后端应用配置（SECRET_KEY、管理员、模型、存储、频道等）统一放在
# backend/.env；不要把密钥写入本文件。

# === 数据库 PostgreSQL ===
GUGU_DB_HOST=postgres
GUGU_DB_PORT=5432
GUGU_DB_NAME=gugu
GUGU_DB_USER=gugu
GUGU_DB_PASSWORD=请替换为数据库密码

# === Redis ===
GUGU_REDIS_HOST=redis
GUGU_REDIS_PORT=6379
GUGU_REDIS_PASSWORD=

# === Compose 入口与镜像 ===
GUGU_HTTP_PORT=9595
# 生产 Compose 必填；Preview/Dev Compose 默认使用本地 :local 镜像。
# GUGU_BACKEND_IMAGE=你的镜像仓库/gugu-backend:latest
# GUGU_FRONTEND_IMAGE=你的镜像仓库/gugu-frontend:latest

# 用户可访问的公开站点根地址；域名部署时改为实际 HTTPS 地址。
GUGU_PUBLIC_APP_URL=http://localhost:9595

# === Shell 沙盒 ===
GUGU_SANDBOX_ENABLED=true
GUGU_SANDBOX_NETWORK_PROFILE=egress
# 使用宿主机 Docker 时按实际 socket 修改；Rootless Docker 可填写对应路径。
# GUGU_DOCKER_SOCKET=/var/run/docker.sock

# === 可选服务 ===
SEARXNG_BASE_URL=http://searxng:8080/
