# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pm_studio
REDIS_URL=redis://localhost:6379/0

# === 安全 ===
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === AI ===
QWEN_API_KEY=your-qwen-api-key
