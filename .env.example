# 咕咕 Compose 编排环境变量示例
# 用法：复制为项目根目录 .env，供 Docker Compose 做变量替换：
#   cp .env.example .env
#   cp backend/.env.example backend/.env
#
# 后端应用配置（SECRET_KEY、管理员、模型、存储、频道等）统一放在
# backend/.env；不要把密钥写入本文件。

# === 数据库 PostgreSQL ===
GUGU_DB_HOST=postgres
GUGU_DB_PORT=5432
GUGU_DB_NAME=gugu
GUGU_DB_USER=gugu
GUGU_DB_PASSWORD=请替换为数据库密码

# === Redis ===
GUGU_REDIS_HOST=redis
GUGU_REDIS_PORT=6379
GUGU_REDIS_PASSWORD=

# === Compose 入口与镜像 ===
GUGU_HTTP_PORT=9595
# 默认 docker-compose.yml 使用一体化单容器镜像；源码 Dev/生产分离 Compose
# 使用下面的分离镜像变量。
GUGU_WEB_IMAGE=coffeiz/gugu-web:latest
# 仅 Dev/生产分离编排使用：
# GUGU_BACKEND_IMAGE=你的镜像仓库/gugu-backend:latest
# GUGU_FRONTEND_IMAGE=你的镜像仓库/gugu-frontend:latest

# 用户可访问的公开站点根地址；域名部署时改为实际 HTTPS 地址。
GUGU_PUBLIC_APP_URL=http://localhost:9595

# 用户数据宿主机目录。Compose 会自动创建默认的 Gugu-data 目录；这里用 PWD
# 解析成绝对路径，便于 Shell 沙盒的宿主机 daemon 复用同一路径：
# 也可以改成宿主机上的绝对路径，如 /home/me/gugu-data；启用 Shell 沙盒时请使用绝对路径。
# 自定义后文件库与沙盒兄弟容器会看到同一份用户数据。
GUGU_DATA_HOST_DIR=${PWD}/Gugu-data
# 从 v1.0.5 或更早版本升级时，旧 named volume 会由 data-migrate 自动迁移；
# 自定义 Compose project name 的旧部署请填写实际卷名：
# GUGU_LEGACY_DATA_VOLUME=gugu-web-compose_gugu_data

# === Shell 沙盒 ===
GUGU_SANDBOX_ENABLED=true
GUGU_SANDBOX_NETWORK_PROFILE=egress
# 使用宿主机 Docker 时按实际 socket 修改；Rootless Docker 可填写对应路径。
# GUGU_DOCKER_SOCKET=/var/run/docker.sock

# === 可选服务 ===
SEARXNG_BASE_URL=http://searxng:8080/
