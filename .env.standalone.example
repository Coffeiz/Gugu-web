# standalone 部署配置（复制为项目根目录的 .env.standalone）。
# 仅支持 linux/amd64；需要 Docker 20+ 与 Compose v2。
# 启动时使用：docker compose --env-file .env.standalone -f docker-compose.standalone.yml up -d

# 必填：不要使用公开默认值。
SECRET_KEY=
GUGU_DB_PASSWORD=

# 默认 /data。部署前请 mkdir -p /data，并确保当前 Docker 用户可写。
GUGU_DATA_HOST_DIR=/data

# 预构建镜像；本地构建时改为 gugu-web-standalone:phase2 或 :local。
GUGU_WEB_IMAGE=coffeiz/gugu-web:latest
GUGU_HTTP_PORT=9595
GUGU_PUBLIC_APP_URL=http://localhost:9595

# 可选：不设置时首次启动自动生成，并只追加保存到 backend/.env。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# 可选 Redis 密码、数据库名称/用户名。
# GUGU_REDIS_PASSWORD=
# GUGU_DB_NAME=gugu
# GUGU_DB_USER=gugu

# 可选 Shell 沙盒。默认 compose 不启用 sandbox profile。
# GUGU_SANDBOX_ENABLED=true
# GUGU_SANDBOX_NETWORK_PROFILE=egress
# GUGU_DOCKER_SOCKET=/var/run/docker.sock
