{
  "name": "@gugu/webui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "predev": "corepack pnpm@10.15.0 --filter @gugu/fs build",
    "dev": "tsx watch src/main.ts",
    "prebuild": "corepack pnpm@10.15.0 --filter @gugu/fs build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pretest": "corepack pnpm@10.15.0 --filter @gugu/fs build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "pretypecheck": "corepack pnpm@10.15.0 --filter @gugu/fs build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "@fastify/static": "10.1.5",
    "@gugu/core": "workspace:*",
    "@gugu/fs": "workspace:*",
    "bcryptjs": "3.0.2",
    "fastify": "5.12.8",
    "image-size": "2.0.4",
    "jszip": "3.10.2",
    "mime-types": "2.1.35",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "tar": "7.5.23",
    "unzipper": "0.12.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.19.4",
    "typescript": "6.0.3"
  }
}
