# 咕咕后端应用环境变量示例
# 用法：复制为 backend/.env，按需填写：
#   cp backend/.env.example backend/.env
#
# Docker Compose 会用自身的 environment 覆盖 DB__*、REDIS__* 等容器连接值；
# systemd/直接启动后端时，这些值用于连接本机或远程服务。
# Admin 面板保存的 config.override.json 优先级高于本文件。

# === 安全（生产必填）===
SECRET_KEY=请替换为随机长字符串
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === 后台管理员（生产必填）===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为管理员密码

# === 站点公开信息（可选）===
PUBLIC_APP_URL=http://localhost:9595
GUGU_SITE_ICP_NUMBER=
GUGU_SITE_ICP_URL=https://beian.miit.gov.cn/

# === 数据库 PostgreSQL ===
DB__HOST=localhost
DB__PORT=5432
DB__NAME=gugu_web
DB__USER=gugu
DB__PASSWORD=请替换为数据库密码

# === Redis（接入 IM 频道时使用）===
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=

# === Shell 沙盒 ===
SANDBOX__ENABLED=true
SANDBOX__NETWORK_PROFILE=egress

# === AI Provider（也可在 Admin 面板配置）===
# provider: qwen | openai | deepseek | minimax | anthropic
AI__PROVIDER=qwen
AI__API_KEY=
AI__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI__MODEL=qwen-max

# === 存储（默认本地）===
STORAGE__BACKEND=local
STORAGE__LOCAL_PATH=./uploads
# STORAGE__OSS_ACCESS_KEY_ID=
# STORAGE__OSS_ACCESS_KEY_SECRET=
# STORAGE__OSS_BUCKET=gugu-web
# STORAGE__OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# STORAGE__OSS_PREFIX=

# === 联网搜索（可选）===
# SEARCH__TAVILY_API_KEY=

# === 飞书频道（可选）===
# FEISHU__APP_ID=cli_xxxx
# FEISHU__APP_SECRET=
# FEISHU__REDIRECT_URI=https://你的域名/api/v1/feishu/bind/callback
# FEISHU__ENCRYPT_KEY=
# FEISHU__VERIFICATION_TOKEN=
