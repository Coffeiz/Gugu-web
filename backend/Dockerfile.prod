# syntax=docker/dockerfile:1
# 咕咕后端生产镜像：构建工具只存在于 builder，最终运行层不携带开发工具链。
# 生产 Compose 的 backend、worker、gateway 和 sandboxd 共用本镜像。

FROM python:3.14-slim-trixie AS builder

ARG APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

RUN sed -i \
        -e "s|https\?://deb.debian.org/debian|${APT_MIRROR}/debian|g" \
        -e "s|https\?://security.debian.org/debian-security|${APT_MIRROR}/debian-security|g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libpq-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
COPY backend/requirements.txt ./requirements.txt

RUN python -m venv /opt/venv
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/pip install -i "${PIP_INDEX_URL}" -r requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/pip install --upgrade --force-reinstall \
        -i "${PIP_INDEX_URL}" \
        "msgpack==1.2.2" "setuptools==84.0.0" \
    && /opt/venv/bin/python -c "from importlib.metadata import version; assert version('msgpack') == '1.2.2'; assert version('setuptools') == '84.0.0'"

# TS worker 的构建物已经提交到 backend/bin；这里只准备它运行时需要的
# Linux native 依赖，不把 TS 源码、测试或构建工具带进最终镜像。
FROM node:22-trixie AS rag-runtime

WORKDIR /rag
COPY backend/ts/workers/rag/package.json ./package.json
RUN npm install --omit=dev --ignore-scripts --no-fund --no-audit \
        ali-oss@6.23.0 \
        @node-rs/jieba@2.0.1 \
        @node-rs/jieba-linux-x64-gnu@2.0.1 \
    && node -e "Promise.all([import('@node-rs/jieba'), import('ali-oss')]).then(() => console.log('RAG runtime dependencies ready'))"

FROM python:3.14-slim-trixie

ARG APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# LibreOffice 用于 doc/docx/ppt 转 PDF 预览，默认保留；不需要文档预览时可关闭，
# 以换取约 500MB 的镜像体积收益：--build-arg GUGU_INSTALL_LIBREOFFICE=false。
ARG GUGU_INSTALL_LIBREOFFICE=true
# CVE-2026-18297（gstreamer-plugins-base OGG 任意代码执行，HIGH）安全门补丁：
# 该库经 ffmpeg/libreoffice 依赖链进入镜像；默认 APT_MIRROR（TUNA）对
# trixie-security 的同步可能滞后，apt 只能装到带漏洞的 1.26.2-1+deb13u1，
# trivy 门会挂（2026-09-09 docker-release 连败根因）。这里在 apt 安装后绕过
# 镜像源、直接从 Debian security pool 拉修复版安装，不依赖索引新鲜度。
# 镜像源自身同步到 >= 修复版后可删除对应两行。
ARG TARGETARCH
ARG GSTREAMER_BASE_FIXED_DEB=libgstreamer-plugins-base1.0-0_1.26.2-1+deb13u2

RUN sed -i \
        -e "s|https\?://deb.debian.org/debian|${APT_MIRROR}/debian|g" \
        -e "s|https\?://security.debian.org/debian-security|${APT_MIRROR}/debian-security|g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        poppler-utils \
        fonts-noto-cjk \
        ffmpeg \
        curl \
        docker-cli \
        nodejs \
        acl \
        $(if [ "${GUGU_INSTALL_LIBREOFFICE}" = "true" ]; then echo libreoffice; fi) \
    && curl -fsSL -o /tmp/gst-base.deb \
        "https://deb.debian.org/debian-security/pool/updates/main/g/gst-plugins-base1.0/${GSTREAMER_BASE_FIXED_DEB}_${TARGETARCH}.deb" \
    && apt-get install -y --no-install-recommends /tmp/gst-base.deb \
    && rm -f /tmp/gst-base.deb \
    && rm -rf /var/lib/apt/lists/*

# 基础包安全补丁升级：APT_MIRROR（TUNA）对 trixie-security 同步滞后，镜像里的
# gzip/glib/mbedtls/pcre2/python3.13/sqlite3/libssh2/perl 等会停在带 CVE 的旧版
# （2026-09-12 docker-release trivy 门连败根因，29 HIGH/CRITICAL）。逐包追 deb 是
# 无底洞，这里把源切回官方 security pool 做一次完整 upgrade，自动覆盖后续 CVE；
# 镜像源同步追平后可把 sed 段去掉。
RUN sed -i \
        -e "s|https\?://${APT_MIRROR}/debian-security|https://deb.debian.org/debian-security|g" \
        -e "s|https\?://${APT_MIRROR}/debian|https://deb.debian.org/debian|g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GUGU_EMBEDDED_DEPS=0

# 业务 ENV 默认值与 docker-compose.prod.yml 注入的值保持一致：分离部署虽然总由
# compose 显式注入，但声明默认值后面板（fnOS 等）枚举镜像变量时有据可依，
# 裸跑时也不会静默回落 config.py 的 localhost/gugu_web 开发默认。
# SECRET_KEY / DB__PASSWORD 留空，由 .env 或环境变量填写。
ENV DB__HOST=postgres \
    DB__PORT=5432 \
    DB__NAME=gugu \
    DB__USER=gugu \
    DB__PASSWORD="" \
    REDIS__HOST=redis \
    REDIS__PORT=6379

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY backend/app ./app
COPY backend/agent ./agent
COPY backend/onboarding ./onboarding
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY backend/worker.py ./worker.py
COPY backend/docker-entrypoint.sh ./docker-entrypoint.sh
COPY backend/compose_bootstrap.py ./compose_bootstrap.py
COPY backend/scripts/migrate_storage_root.py ./scripts/migrate_storage_root.py
COPY backend/scripts/sandbox_rootless_init.sh /usr/local/bin/gugu-sandbox-init.sh
COPY backend/bin/gugu-rag-ts-worker.mjs ./bin/gugu-rag-ts-worker.mjs
COPY backend/bin/gugu-filesync-ts-worker.cjs ./bin/gugu-filesync-ts-worker.cjs
COPY --from=rag-runtime /rag/node_modules ./bin/node_modules
COPY backend/scripts/prepare_rootless_storage.py /usr/local/bin/prepare_rootless_storage.py
RUN mkdir -p logs \
    && chmod 755 docker-entrypoint.sh /usr/local/bin/gugu-sandbox-init.sh /usr/local/bin/prepare_rootless_storage.py \
    && test ! -e /app/.venv \
    && test ! -e /app/.deploy-backups \
    && test ! -e /app/ts \
    && test ! -e /app/tests \
    && test ! -e /app/docs \
    && ! command -v gcc \
    && ! command -v g++ \
    && ! command -v make \
    && ! command -v git \
    && ! command -v hg

RUN node bin/gugu-rag-ts-worker.mjs --version \
    && node bin/gugu-filesync-ts-worker.cjs --version

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -sf http://127.0.0.1:8000/health

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
