# 咕咕后端生产镜像：只复制构建上下文，不挂载宿主机源码。
FROM python:latest

ARG APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

RUN sed -i \
        -e "s|https\?://deb.debian.org/debian|${APT_MIRROR}/debian|g" \
        -e "s|https\?://security.debian.org/debian-security|${APT_MIRROR}/debian-security|g" \
        /etc/apt/sources.list.d/debian.sources

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        poppler-utils fonts-noto-cjk ffmpeg curl build-essential docker-cli nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -i "${PIP_INDEX_URL}" -r requirements.txt
# python:latest 可能预装旧版 setuptools/msgpack；强制重装并校验最终版本，避免旧
# dist-info 留在镜像中导致发布安全扫描仍识别出已修复漏洞。
RUN pip install --no-cache-dir --upgrade --force-reinstall \
        -i "${PIP_INDEX_URL}" \
        "msgpack==1.2.2" "setuptools==84.0.0" \
    && python -c "from importlib.metadata import version; assert version('msgpack') == '1.2.2'; assert version('setuptools') == '84.0.0'"

COPY backend ./
RUN mkdir -p logs \
    && chmod 755 docker-entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -sf http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
