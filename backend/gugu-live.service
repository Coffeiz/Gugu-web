[Unit]
Description=Gugu TypeScript Live Event API
After=network.target redis.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__/ts
EnvironmentFile=-__APP_DIR__/.env
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="TS_LIVE_PORT=8585"
# 开发环境前端通过 8585 直连；生产环境建议替换为实际前端 Origin 列表。
Environment="TS_LIVE_ALLOWED_ORIGINS=http://192.168.110.51:5173,http://192.168.110.51:5174,http://localhost:5173,http://localhost:5174"
ExecStart=__APP_DIR__/ts/node_modules/.bin/tsx __APP_DIR__/ts/api/live.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__APP_DIR__/logs
StandardOutput=append:__APP_DIR__/logs/gugu-live.log
StandardError=append:__APP_DIR__/logs/gugu-live.log

[Install]
WantedBy=multi-user.target
