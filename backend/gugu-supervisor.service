[Unit]
Description=Gugu IM Supervisor (拉起并看管飞书/QQ 网关子进程)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__
Environment="PATH=__APP_DIR__/.venv/bin"
Environment="DB_STARTUP_TIMEOUT=10"
ExecStart=__APP_DIR__/.venv/bin/python -m agent.adapters.supervisor
# 网关管家，死了连带网关一起没，必须自动拉起
Restart=always
RestartSec=3
# 重启时连带清掉它 spawn 的网关子进程（同 cgroup），再由新进程统一拉起
KillMode=control-group

# 写进 Debug 面板读的日志文件（而非 journal），让后台「Debug 实时日志」能 tail 到
StandardOutput=append:__APP_DIR__/logs/gugu-supervisor.log
StandardError=append:__APP_DIR__/logs/gugu-supervisor.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__APP_DIR__/uploads __APP_DIR__/logs __APP_DIR__/config.override.json

[Install]
WantedBy=multi-user.target
