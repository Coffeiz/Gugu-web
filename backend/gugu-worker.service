[Unit]
Description=Gugu IM Worker (消费 im:inbound 队列，跑 agent 回复)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__
# venv bin 优先、后面接完整系统路径——只给 venv bin 会让 subprocess 调用系统命令
# （libreoffice/pdftotext/ffmpeg 等）时报 FileNotFoundError
Environment="PATH=__APP_DIR__/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Shell 沙盒固定使用服务用户自己的 Rootless Docker，不得回落到 rootful socket
Environment="DOCKER_HOST=unix:///run/user/__RUN_UID__/docker.sock"
Environment="GUGU_SANDBOXD_SOCKET=/run/user/__RUN_UID__/gugu-sandboxd.sock"
Environment="DB_STARTUP_TIMEOUT=10"
# 开发/联调环境启用 LoopScope；没有这个变量时 worker 会静默跳过 IM trace 上报
Environment="LOOPSCOPE_ENABLED=1"
Environment="LOOPSCOPE_ENDPOINT=http://127.0.0.1:4320"
ExecStart=__APP_DIR__/.venv/bin/python -m worker
# IM 大脑，死了必须立刻拉起，否则消息无限排队
Restart=always
RestartSec=3

# 写进 Debug 面板读的日志文件（而非 journal），让后台「Debug 实时日志」能 tail 到
StandardOutput=append:__APP_DIR__/logs/gugu-worker.log
StandardError=append:__APP_DIR__/logs/gugu-worker.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__ __APP_DIR__/logs __APP_DIR__/var/rag-index __APP_DIR__/config.override.json

[Install]
WantedBy=multi-user.target
