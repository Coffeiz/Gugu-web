{
  "name": "@gugu/backend-ts",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@gugu/backend-ts",
      "workspaces": [
        "packages/*",
        "workers/*"
      ],
      "engines": {
        "node": ">=22 <23"
      }
    },
    "node_modules/@gugu/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/gugu-rag-ts-worker": {
      "resolved": "workers/rag",
      "link": true
    },
    "packages/contracts": {
      "name": "@gugu/contracts"
    },
    "workers/rag": {
      "name": "gugu-rag-ts-worker",
      "dependencies": {
        "@node-rs/jieba": "2.0.1"
      }
    },
    "workers/rag/node_modules/@node-rs/jieba": {
      "version": "2.0.1",
      "license": "MIT",
      "engines": {
        "node": ">= 10"
      },
      "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/Brooooooklyn"
      },
      "optionalDependencies": {
        "@node-rs/jieba-android-arm-eabi": "2.0.1",
        "@node-rs/jieba-android-arm64": "2.0.1",
        "@node-rs/jieba-darwin-arm64": "2.0.1",
        "@node-rs/jieba-darwin-x64": "2.0.1",
        "@node-rs/jieba-freebsd-x64": "2.0.1",
        "@node-rs/jieba-linux-arm-gnueabihf": "2.0.1",
        "@node-rs/jieba-linux-arm64-gnu": "2.0.1",
        "@node-rs/jieba-linux-arm64-musl": "2.0.1",
        "@node-rs/jieba-linux-x64-gnu": "2.0.1",
        "@node-rs/jieba-linux-x64-musl": "2.0.1",
        "@node-rs/jieba-wasm32-wasi": "2.0.1",
        "@node-rs/jieba-win32-arm64-msvc": "2.0.1",
        "@node-rs/jieba-win32-ia32-msvc": "2.0.1",
        "@node-rs/jieba-win32-x64-msvc": "2.0.1"
      }
    },
    "workers/rag/node_modules/@node-rs/jieba-darwin-arm64": {
      "version": "2.0.1",
      "cpu": [
        "arm64"
      ],
      "license": "MIT",
      "optional": true,
      "os": [
        "darwin"
      ],
      "engines": {
        "node": ">= 10"
      }
    }
