{
  "name": "@gugu/backend-ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "gen:api": "node scripts/generate-api-contract.mjs",
    "lint": "node scripts/typecheck.mjs",
    "test": "node --import tsx --test api/*.test.ts workers/chart-renderer/test/*.test.mjs packages/contracts/test/*.test.ts packages/filesync-watcher/test/*.test.ts",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "dependencies": {
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
