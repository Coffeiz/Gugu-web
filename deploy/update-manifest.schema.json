{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coffeiz/Gugu-web/releases/download/manifest-schema/update-manifest.schema.json",
  "title": "Gugu Docker update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "channel",
    "minimum_version",
    "app_image",
    "architectures",
    "database_migration",
    "release_notes_url",
    "rollback_supported"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "channel": { "type": "string", "enum": ["stable", "beta"] },
    "minimum_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "app_image": {
      "type": "string",
      "pattern": "^(?:docker\\.io|ghcr\\.io)/coffeiz/gugu-web@sha256:[0-9a-f]{64}$"
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["linux/amd64", "linux/arm64"] }
    },
    "database_migration": { "type": "boolean" },
    "release_notes_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/Coffeiz/Gugu-web/releases/" },
    "rollback_supported": { "type": "boolean" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
