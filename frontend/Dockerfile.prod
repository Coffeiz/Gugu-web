# 咕咕前端生产镜像：构建 dist 后只保留 Nginx 静态站点。
FROM node:20-slim AS build

# package.json 的 file:../../gugu-interaction-runtime 依赖需要在构建阶段保留
# 同级 Runtime；最终镜像不会包含源码或 node_modules。
COPY frontend/package.json frontend/package-lock.json /workspace/frontend/
COPY gugu-interaction-runtime /gugu-interaction-runtime
WORKDIR /workspace/frontend
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf
