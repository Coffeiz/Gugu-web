{
  "name": "gugu-web",
  "version": "1.0.5",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.js",
    "build": "vite build",
    "build:verify": "npm run build && npm run test:css-glass && npm run test:ui-dialogs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:strict": "vue-tsc -p tsconfig.strict.json --noEmit",
    "i18n:scan": "node scripts/check-i18n-static.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:fast": "vitest run src test",
    "test:css-glass": "node scripts/check-css-glass-regression.mjs",
    "test:ui-dialogs": "node scripts/check-ui-dialog-regression.mjs",
    "licenses:generate": "node ../scripts/licenses/generate-licenses.mjs",
    "licenses:check": "node ../scripts/licenses/check-licenses.mjs",
    "test:e2e": "playwright test",
    "test:e2e:stable": "playwright test e2e/smoke.spec.ts e2e/calendar.spec.ts e2e/chat.spec.ts e2e/file-lifecycle.spec.ts e2e/mind-canvas-runtime.spec.ts e2e/scheduled-task-ui.spec.ts e2e/scheduled-task-run.spec.ts",
    "test:e2e:experimental": "playwright test e2e/file-drag-runtime.spec.ts e2e/filesystem-phases.spec.ts",
    "gen:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/types/api.ts"
  },
