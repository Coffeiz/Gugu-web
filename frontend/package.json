    "qrcode": "^1.5.4",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.3",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.3.0",
    "xterm": "^5.3.0"
