    "src/components/common/GlobalSearch.vue",
    "src/components/common/GlassBg.vue",
    "src/components/common/UploadConflictDialog.vue",
    "src/components/common/AvatarCropper.vue",
    "src/components/common/SegBar.vue",
    "src/components/common/NotificationBubble.vue",
    "src/components/common/viewers/TextViewer.vue",
    "src/components/common/FilePreviewModal.vue",
