{
  "name": "@gugu/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "exports": {
    ".": "./dist/index.js",
    "./contracts": "./dist/contracts/index.js",
    "./desktop": "./dist/contracts/desktop.js",
    "./transport": "./dist/runtime/commands.js",
    "./executor": "./dist/agent/executor/contracts.js",
    "./executor/policy": "./dist/agent/executor/policy.js",
    "./executor/platform": "./dist/agent/executor/platform.js",
    "./ipc": "./dist/runtime/transport/ipc.js",
    "./domain": "./dist/domain/index.js",
    "./data": "./dist/data/index.js",
    "./local": "./dist/runtime/local.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "pnpm build && tsc -p tsconfig.tests.json",
    "test": "node scripts/run-tests.mjs default",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:ipc": "node scripts/run-tests.mjs ipc",
    "test:postgres": "node scripts/run-tests.mjs postgres",
    "test:parity": "node scripts/run-tests.mjs parity",
    "test:golden": "node scripts/run-tests.mjs parity",
    "test:all": "node scripts/run-tests.mjs all",
    "test:list": "node scripts/run-tests.mjs all --list",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "kysely": "0.29.8",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.3",
    "pg": "8.23.1",
    "@microsoft/mxc-sdk": "1.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
