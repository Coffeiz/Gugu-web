GUGU_WEBUI_DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>
# 可选；默认读取仓库 backend/config.override.json。容器部署使用持久卷中的路径。
GUGU_CONFIG_OVERRIDE_FILE=
SECRET_KEY=replace-with-a-long-random-secret
GUGU_WEBUI_HOST=0.0.0.0
GUGU_WEBUI_PORT=9595
GUGU_WEBUI_PG_POOL_MAX=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_ALLOWED_HOSTS=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 与 Python Host 使用相同的存储后端值；workspace shell 只支持 local。
STORAGE__BACKEND=local
STORAGE__LOCAL_PATH=../Gugu-data/users
FILESYNC__ENABLED=true
# workspace shell runtime capability settings (mirror backend/app/core/config.py)
AGENT__SHELL_ENABLED=true
AGENT__SHELL_SYSTEM_ENABLED=false
AGENT__SHELL_DANGEROUS_ENABLED=true
AGENT__AUTOMATIC_MODE_ENABLED=true
SANDBOX__FULL_USER_SANDBOX_AUTHORIZATION_ENABLED=true
SANDBOX__TERMINAL_MODE=auto
GUGU_SANDBOXD_SOCKET=/run/gugu/sandboxd.sock
# 可选的共享 Redis；设置后启用跨进程登录限流、认证撤销通知和资源变更事件。
GUGU_WEBUI_REDIS_URL=
# Redis 密码独立配置；未设置时兼容从 Redis URL 或 config.override.json 读取。
GUGU_WEBUI_REDIS_PASSWORD=
GUGU_WEBUI_PUBLISHED_PORT=9595
# 默认从 workspace 的 frontend/dist 读取；独立部署时可填绝对路径。
GUGU_WEBUI_STATIC_DIR=
GUGU_SITE_ICP_NUMBER=
GUGU_SITE_ICP_URL=https://beian.miit.gov.cn/
SMTP__HOST=
SMTP__USER=
SMTP__PASSWORD=
SMTP__FROM_ADDR=
SMTP__ENABLED=true
SMTP__REGISTRATION_VERIFICATION_ENABLED=true
