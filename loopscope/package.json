{
  "name": "loopscope",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm -r --parallel --filter @loopscope/collector --filter @loopscope/web dev",
    "dev:web": "pnpm --filter @loopscope/web dev",
    "dev:collector": "pnpm --filter @loopscope/collector dev",
    "build": "pnpm --filter @loopscope/contracts build && pnpm --filter @loopscope/db build && pnpm --filter @loopscope/storage build && pnpm --filter @loopscope/collector build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @loopscope/collector test"
  }
}
