{
  "name": "gugu-web-workspace",
  "version": "1.6.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "corepack pnpm --filter gugu-web dev",
    "dev:loopscope": "corepack pnpm --filter loopscope-web dev",
    "build:web": "corepack pnpm --filter gugu-web build",
    "build:rag": "corepack pnpm --filter gugu-rag-ts-worker build",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "test:fast": "node scripts/tests/run-fast-tests.mjs",
    "test:unit": "TEST_TIER=unit node scripts/tests/run-test-tier.mjs",
    "test:integration": "TEST_TIER=integration node scripts/tests/run-test-tier.mjs",
    "test:e2e": "TEST_TIER=e2e node scripts/tests/run-test-tier.mjs",
    "test:all": "TEST_TIER=all node scripts/tests/run-test-tier.mjs",
    "test:affected": "node scripts/tests/run-affected-tests.mjs",
    "test:metadata": "node scripts/tests/check-test-metadata.mjs",
    "test:maintenance": "node scripts/tests/run-maintenance-audit.mjs",
    "test:inventory": "node scripts/tests/collect-test-inventory.mjs",
    "test:inventory:details": "node scripts/tests/generate-test-details.mjs",
    "test:inventory:domain-details": "node scripts/tests/generate-domain-details.mjs",
    "test:inventory:helpers": "node scripts/tests/audit-test-helpers.mjs",
    "test:inventory:domains": "node scripts/tests/generate-domain-audit.mjs",
    "test:boundaries": "node scripts/tests/check-test-boundaries.mjs"
  }
}
