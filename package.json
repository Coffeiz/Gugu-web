{
  "name": "gugu-web-workspace",
  "version": "0.22.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:web": "pnpm --filter gugu-web dev",
    "dev:loopscope": "pnpm --filter loopscope-web dev",
    "build:web": "pnpm --filter gugu-web build",
    "build:rag": "pnpm --filter gugu-rag-ts-worker build",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
