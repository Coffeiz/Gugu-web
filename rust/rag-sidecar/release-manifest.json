{
  "name": "gugu-rag-sidecar",
  "version": "0.1.0",
  "artifact_path": "backend/bin/gugu-rag-sidecar",
  "artifacts": [
    {
      "path": "backend/bin/gugu-rag-sidecar-linux-x86_64",
      "platform": "linux",
      "target": "x86_64-unknown-linux-gnu"
    },
    {
      "path": "backend/bin/gugu-rag-sidecar-macos-arm64",
      "platform": "macos",
      "target": "aarch64-apple-darwin"
    }
  ],
  "target": "x86_64-unknown-linux-musl",
  "container_runtime": "linux/amd64",
  "runtime_build": false,
  "build_owner": "release-pipeline",
  "verification": [
    "cargo test --manifest-path rust/rag-sidecar/Cargo.toml",
    "sha256sum backend/bin/gugu-rag-sidecar",
    "backend/bin/gugu-rag-sidecar --version"
  ]
}
